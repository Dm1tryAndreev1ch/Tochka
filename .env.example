DATABASE_URL=postgresql://voice:change-me@127.0.0.1:15432/voice
POSTGRES_PASSWORD=change-me
CRM_DATABASE_PASSWORD=change-me-too
CRM_ADMIN_PASSWORD=change-this-admin-password
ADMIN_PASSWORD=change-this-operator-password
MANAGEMENT_SECRET=generate-a-random-32-byte-secret
ESPO_URL=http://127.0.0.1:18081
ESPO_API_KEY=
LLM_URL=http://127.0.0.1:18082/v1
LLM_MODEL=qwen3-4b
LLM_MODEL_PATH=models/qwen3-4b-q4.gguf
LLM_THINKING=false
LLM_PROMPT_PROFILE=compact
LLM_CONTEXT_TOKENS=8192
LLM_REPLY_TOKENS=256
LLM_VOICE_ANSWER_CHARS=180
LLM_GPU_LAYERS=99
LLM_THREADS=4
LLM_API_KEY=generate-a-random-llm-secret
ESPO_ASSIGNED_USER_ID=
ICE_HOST_IP=127.0.0.1
HOST=127.0.0.1
PORT=7860
ALLOWED_HOSTS=localhost,127.0.0.1
ALLOWED_ORIGINS=http://127.0.0.1:7860,http://localhost:7860
WHISPER_MODEL=models/whisper-small
STT_BACKEND=whisper.cpp
WHISPER_METAL_MODEL=models/whisper-turbo-metal.bin
# Acoustic validation rejected shorter global endpoints on human speech.
# 0.45 remains available as an explicit experiment on a separate corpus.
VAD_STOP_SECONDS=0.95
VAD_SENSITIVE_STOP_SECONDS=0.95
STT_PREEMPTIVE_ENABLED=true
STT_PREEMPTIVE_SILENCE_SECONDS=0.12
VOICE_ACKNOWLEDGEMENT_ENABLED=true
VOICE_ACKNOWLEDGEMENT_DELAY_SECONDS=1.8
NATURAL_TTS_ENABLED=true
NATURAL_TTS_MODEL=models/qwen3-tts-base-0.6b
TTS_CACHE_MAX_BYTES=8388608
TTS_CACHE_MAX_ENTRIES=128
MALE_SPEECH_RATE=1.10
PIPER_MODEL=models/ru_RU-denis-medium.onnx
COOKIE_SECURE=false
SESSION_TTL_SECONDS=3600
RETENTION_DAYS=30
