+                'SELECT WITH GRANT OPTION,INSERT WITH GRANT OPTION,UPDATE WITH GRANT OPTION,DELETE WITH GRANT OPTION'))
+            ELSE false END)
         OR EXISTS(SELECT 1 FROM pg_catalog.pg_class c
